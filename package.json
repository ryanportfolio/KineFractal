{
  "name": "kinefractal",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "NODE_ENV=development tsx server/index-dev.ts",
    "build": "vite build && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "check:snapshot": "node scripts/check-snapshot-sync.mjs",
    "db:push": "drizzle-kit push",
    "sync:snapshot": "node scripts/sync-snapshot.mjs",
    "test": "tsx --test \"client/src/**/*.test.{ts,tsx}\" \"shared/*.test.ts\" \"server/*.test.{ts,mjs}\" \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.60.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/fs-extra": "^11.0.4",
    "@types/sanitize-html": "^2.16.0",
    "axios": "^1.13.2",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.23.24",
    "fs-extra": "^11.3.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.545.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "sanitize-html": "^2.17.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "4.17.21",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.1.9"
  }
}
